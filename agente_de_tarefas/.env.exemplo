# Copie este arquivo para .env, na mesma pasta, e preencha com as suas chaves.
# O .env nunca entra no git: ele esta no .gitignore.

# Gemini, pelo Google AI Studio (aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=sua-chave-do-gemini-aqui

# Trello, pelo portal de Power-Ups (trello.com/power-ups/admin)
TRELLO_API_KEY=sua-chave-do-trello-aqui
TRELLO_API_SECRET=seu-segredo-do-trello-aqui
TRELLO_TOKEN=seu-token-do-trello-aqui

# O nome do quadro usado quando voce nao disser outro. No agente original
# isso estava escrito dentro do codigo, como 'DIO'.
TRELLO_BOARD=DIO
